+int mhi_pm_fast_suspend(struct mhi_controller *mhi_cntrl)
+{
+	struct mhi_chan *itr, *tmp;
+	struct mhi_event *ctrl_event = mhi_cntrl->mhi_event;
+	struct device *dev = &mhi_cntrl->mhi_dev->dev;
+	enum mhi_pm_state new_state;
+	u32 status;
+	int ret;
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	if (mhi_cntrl->pm_state == MHI_PM_DISABLE) {
+		read_unlock_bh(&mhi_cntrl->pm_lock);
+		return -EINVAL;
+	}
+	if (MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state) ||
+	    mhi_cntrl->fast_suspended) {
+		read_unlock_bh(&mhi_cntrl->pm_lock);
+		return -EIO;
+	}
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	if (atomic_read(&mhi_cntrl->dev_wake) ||
+	    atomic_read(&mhi_cntrl->pending_pkts))
+		return -EBUSY;
+
+	/* Stabilize an M2 device before making the host inaccessible. */
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	mhi_cntrl->wake_get(mhi_cntrl, false);
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	ret = wait_event_timeout(mhi_cntrl->state_event,
+				 mhi_cntrl->dev_state == MHI_STATE_M0 ||
+				 mhi_cntrl->dev_state == MHI_STATE_M1 ||
+				 MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state),
+				 msecs_to_jiffies(mhi_cntrl->timeout_ms));
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	mhi_cntrl->wake_put(mhi_cntrl, false);
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	if (!ret || MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state)) {
+		dev_err(dev, "fast suspend could not stabilize MHI in M0/M1\n");
+		return -EIO;
+	}
+
+	tasklet_disable(&ctrl_event->task);
+	write_lock_irq(&mhi_cntrl->pm_lock);
+
+	if (atomic_read(&mhi_cntrl->dev_wake) ||
+	    atomic_read(&mhi_cntrl->pending_pkts)) {
+		ret = -EBUSY;
+		goto error_unlock;
+	}
+	if (MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state)) {
+		ret = -EIO;
+		goto error_unlock;
+	}
+
+	mhi_cntrl->saved_pm_state = mhi_cntrl->pm_state;
+	mhi_cntrl->saved_dev_state = mhi_cntrl->dev_state;
+
+	if (mhi_cntrl->pm_state == MHI_PM_M2) {
+		new_state = mhi_tryset_pm_state(mhi_cntrl, MHI_PM_M0);
+		if (new_state != MHI_PM_M0) {
+			ret = -EIO;
+			goto error_unlock;
+		}
+	}
+
+	new_state = mhi_tryset_pm_state(mhi_cntrl, MHI_PM_M3_ENTER);
+	if (new_state != MHI_PM_M3_ENTER) {
+		ret = -EIO;
+		goto error_unlock;
+	}
+	new_state = mhi_tryset_pm_state(mhi_cntrl, MHI_PM_M3);
+	if (new_state != MHI_PM_M3) {
+		ret = -EIO;
+		goto error_unlock;
+	}
+
+	/* Deliberately do not write MHICTRL: the firmware remains in M0/M1. */
+	mhi_cntrl->dev_state = MHI_STATE_M3_FAST;
+	mhi_cntrl->M3_FAST++;
+	mhi_cntrl->fast_suspended = true;
+	write_unlock_irq(&mhi_cntrl->pm_lock);
+
+	/* A readback drains posted host writes before PCIe ownership changes. */
+	ret = mhi_read_reg(mhi_cntrl, mhi_cntrl->regs, MHISTATUS, &status);
+	dev_info(dev,
+		 "fast suspend host=M3 device=M3_FAST saved_pm=%s saved_dev=%s readback=%d status=0x%08x\n",
+		 to_mhi_pm_state_str(mhi_cntrl->saved_pm_state),
+		 mhi_state_str(mhi_cntrl->saved_dev_state), ret,
+		 ret ? 0 : status);
+
+	tasklet_enable(&ctrl_event->task);
+	mhi_irq_handler(0, ctrl_event);
+
+	list_for_each_entry_safe(itr, tmp, &mhi_cntrl->lpm_chans, node) {
+		mutex_lock(&itr->mutex);
+		if (itr->mhi_dev)
+			mhi_notify(itr->mhi_dev, MHI_CB_LPM_ENTER);
+		mutex_unlock(&itr->mutex);
+	}
+
+	return 0;
+
+error_unlock:
+	write_unlock_irq(&mhi_cntrl->pm_lock);
+	tasklet_enable(&ctrl_event->task);
+	mhi_irq_handler(0, ctrl_event);
+	dev_err(dev, "fast suspend failed: %d pm=%s dev=%s\n", ret,
+		to_mhi_pm_state_str(mhi_cntrl->pm_state),
+		mhi_state_str(mhi_cntrl->dev_state));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mhi_pm_fast_suspend);
+
+bool mhi_pm_is_fast_suspended(struct mhi_controller *mhi_cntrl)
+{
+	bool suspended;
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	suspended = mhi_cntrl->fast_suspended;
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	return suspended;
+}
+EXPORT_SYMBOL_GPL(mhi_pm_is_fast_suspended);
+
+int mhi_pm_fast_resume(struct mhi_controller *mhi_cntrl)
+{
+	struct mhi_chan *itr, *tmp;
+	struct mhi_event *mhi_event;
+	struct device *dev = &mhi_cntrl->mhi_dev->dev;
+	enum mhi_pm_state restored_pm;
+	enum mhi_state restored_dev;
+	enum mhi_ee_type ee;
+	int i, ret = 0;
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	if (mhi_cntrl->pm_state == MHI_PM_DISABLE) {
+		read_unlock_bh(&mhi_cntrl->pm_lock);
+		return 0;
+	}
+	if (MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state) ||
+	    !mhi_cntrl->fast_suspended ||
+	    mhi_cntrl->pm_state != MHI_PM_M3) {
+		read_unlock_bh(&mhi_cntrl->pm_lock);
+		return -EIO;
+	}
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	ee = mhi_get_exec_env(mhi_cntrl);
+	if (ee == MHI_EE_RDDM) {
+		dev_err(dev, "fast resume found firmware in RDDM\n");
+		return -EIO;
+	}
+
+	list_for_each_entry_safe(itr, tmp, &mhi_cntrl->lpm_chans, node) {
+		mutex_lock(&itr->mutex);
+		if (itr->mhi_dev)
+			mhi_notify(itr->mhi_dev, MHI_CB_LPM_EXIT);
+		mutex_unlock(&itr->mutex);
+	}
 
+	tasklet_disable(&mhi_cntrl->mhi_event->task);
+	write_lock_irq(&mhi_cntrl->pm_lock);
+	if (MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state)) {
+		write_unlock_irq(&mhi_cntrl->pm_lock);
+		tasklet_enable(&mhi_cntrl->mhi_event->task);
+		return -EIO;
+	}
+
+	restored_pm = mhi_cntrl->saved_pm_state;
+	restored_dev = mhi_cntrl->saved_dev_state;
+	mhi_cntrl->pm_state = restored_pm;
+	mhi_cntrl->dev_state = restored_dev;
+	mhi_cntrl->fast_suspended = false;
+	write_unlock_irq(&mhi_cntrl->pm_lock);
+
+	switch (restored_pm) {
+	case MHI_PM_M0:
+		ret = mhi_pm_m0_transition(mhi_cntrl);
+		break;
+	case MHI_PM_M2:
+		read_lock_bh(&mhi_cntrl->pm_lock);
+		mhi_cntrl->wake_get(mhi_cntrl, true);
+		mhi_cntrl->wake_put(mhi_cntrl, true);
+		read_unlock_bh(&mhi_cntrl->pm_lock);
+		break;
+	default:
+		ret = -EIO;
+		break;
+	}
+
+	tasklet_enable(&mhi_cntrl->mhi_event->task);
+	if (ret)
+		return ret;
+
+	/* The device may have queued events while the applications CPU slept. */
+	mhi_event = mhi_cntrl->mhi_event;
+	for (i = 0; i < mhi_cntrl->total_ev_rings; i++, mhi_event++) {
+		if (mhi_event->offload_ev)
+			continue;
+		mhi_irq_handler(0, mhi_event);
+	}
+
+	dev_info(dev, "fast resume restored pm=%s dev=%s ee=%s\n",
+		 to_mhi_pm_state_str(restored_pm), mhi_state_str(restored_dev),
+		 TO_MHI_EXEC_STR(ee));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mhi_pm_fast_resume);

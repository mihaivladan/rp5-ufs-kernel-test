 	return -EOPNOTSUPP;
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -2294,7 +2294,57 @@
 	pcie->orderly_poweroff = false;
 	if (pdev)
 		pci_dev_put(pdev);
+}
+
+int qcom_pcie_orderly_poweroff_prepare(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *bridge;
+	struct qcom_pcie *pcie;
+	int ret;
+
+	if (!pdev || pdev->vendor != PCI_VENDOR_ID_QCOM ||
+	    pdev->device != 0x1101)
+		return -ENODEV;
+
+	bridge = pci_find_host_bridge(pdev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return -ENODEV;
+
+	pcie = dev_get_drvdata(bridge->dev.parent);
+	if (!pcie || !pcie->drv_supported || pcie->drv_dev_id != 0)
+		return -EOPNOTSUPP;
+	if (pcie->drv_armed || pcie->drv_offline || pcie->orderly_poweroff)
+		return -EBUSY;
+	if (!dw_pcie_link_up(pcie->pci))
+		return -ENOLINK;
+
+	/* Android runtime-resumes the link from PCIe-DRV immediately before
+	 * its final radio shutdown.  Exercise the equivalent ENABLE/DISABLE
+	 * transaction here while the endpoint is still responsive, without
+	 * carrying ownership into the subsequent system suspend.
+	 */
+	ret = qcom_pcie_drv_handoff(pcie->drv_dev_id,
+				    pcie->drv_l1ss_timeout_ms);
+	if (ret) {
+		dev_err(pcie->pci->dev,
+			"orderly QCA power-off: pre-shutdown ADSP handoff failed: %d\n",
+			ret);
+		return ret;
+	}
+
+	ret = qcom_pcie_drv_reclaim(pcie->drv_dev_id);
+	if (ret) {
+		dev_err(pcie->pci->dev,
+			"orderly QCA power-off: pre-shutdown ADSP reclaim failed: %d\n",
+			ret);
+		return ret;
+	}
+
+	dev_info(pcie->pci->dev,
+		 "orderly QCA power-off: pre-shutdown ADSP handoff/reclaim complete\n");
+	return 0;
 }
+EXPORT_SYMBOL_GPL(qcom_pcie_orderly_poweroff_prepare);
 
 int qcom_pcie_orderly_poweroff_arm(struct pci_dev *pdev)
 {
--- a/drivers/net/wireless/ath/ath11k/pci.h

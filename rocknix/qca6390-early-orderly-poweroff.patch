@@ -1362,11 +1382,14 @@
 static __maybe_unused int ath11k_pci_pm_resume_early(struct device *dev)
 {
 	struct ath11k_base *ab = dev_get_drvdata(dev);
+	struct ath11k_pci *ab_pci = ath11k_pci_priv(ab);
 	int ret;
 

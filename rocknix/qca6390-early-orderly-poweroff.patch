 };
 
 static inline struct ath11k_pci *ath11k_pci_priv(struct ath11k_base *ab)
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -1319,6 +1319,22 @@
 						 MHI_CHANNEL_SUSPEND_RETAINED);
 		ath11k_info(ab,
 			    "orderly QCA power-off: preserving QMI transport for late firmware stop\n");
+
+		/* Run the endpoint transaction in the normal suspend phase, while
+		 * the rest of the platform and the QMI transport are still awake.
+		 * The root port completes L23/PHY/rail shutdown in noirq after PCI
+		 * core has placed this endpoint in D3hot.
+		 */
+		ret = ath11k_core_suspend_late(ab);
+		if (ret) {
+			ath11k_warn(ab,
+				    "orderly QCA power-off: early endpoint shutdown failed: %d\n",
+				    ret);
+			return ret;
+		}
+		ab_pci->orderly_early_down = true;
+		ath11k_info(ab,
+			    "orderly QCA power-off: endpoint shutdown completed in normal suspend phase\n");

 #if IS_ENABLED(CONFIG_PCIE_QCOM)
+int qcom_pcie_orderly_poweroff_prepare(struct pci_dev *pdev);
 int qcom_pcie_orderly_poweroff_arm(struct pci_dev *pdev);
 void qcom_pcie_orderly_poweroff_disarm(struct pci_dev *pdev);
 #else
+static inline int qcom_pcie_orderly_poweroff_prepare(struct pci_dev *pdev)
+{

From: ConsoleOS <consoleos@localhost>
Date: Sun, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] hwmon: pwm-fan: support an explicit startup speed

ROCKNIX's SM8250 patch starts every pwm-fan at a fixed PWM value of 70. Keep
that downstream default when firmware provides no policy. Some handhelds
instead need a silent startup and have a userspace or thermal policy ready to
take over shortly after probe.

Add an optional fan-startup-percent property. Apply a zero-percent request
directly to the PWM because the normal set_pwm(0) path is a no-op before the
driver has marked the fan enabled. Non-zero values continue through the
normal power and regulator sequence.
---
--- a/Documentation/devicetree/bindings/hwmon/pwm-fan.yaml
+++ b/Documentation/devicetree/bindings/hwmon/pwm-fan.yaml
@@ -66,6 +66,15 @@
   "#cooling-cells":
     const: 2
 
+  fan-startup-percent:
+    description:
+      Fan speed in percent applied when the driver probes. If omitted, the
+      driver's existing startup policy is used for backwards compatibility.
+      A value of zero explicitly disables the PWM output until a thermal or
+      userspace policy requests a non-zero speed.
+    minimum: 0
+    maximum: 100
+
 required:
   - compatible
   - pwms
--- a/drivers/hwmon/pwm-fan.c
+++ b/drivers/hwmon/pwm-fan.c
@@ -498,12 +498,13 @@
 {
 	struct thermal_cooling_device *cdev;
 	struct device *dev = &pdev->dev;
+	struct pwm_state *state;
 	struct pwm_fan_ctx *ctx;
 	struct device *hwmon;
 	int ret;
 	const struct hwmon_channel_info **channels;
 	u32 initial_pwm, pwm_min_from_stopped = 0;
-	u32 pwm_shutdown_percent = 0;
+	u32 pwm_shutdown_percent = 0, pwm_startup_percent;
 	u32 *fan_channel_config;
 	int channel_count = 1;	/* We always have a PWM channel. */
 	int i;
@@ -560,16 +561,36 @@
 		initial_pwm = ctx->pwm_fan_cooling_levels[ctx->pwm_fan_max_state];
 	else
 		initial_pwm = MAX_PWM;
+
+	if (!device_property_read_u32(dev, "fan-startup-percent",
+				      &pwm_startup_percent)) {
+		pwm_startup_percent = clamp_t(u32, pwm_startup_percent, 0, 100);
+		initial_pwm = DIV_ROUND_CLOSEST(pwm_startup_percent * MAX_PWM,
+						100);
+	} else {
+		/* Preserve ROCKNIX's existing SM8250 fixed startup policy. */
+		initial_pwm = 70;
+	}
 
 	/*
 	 * Set duty cycle to maximum allowed and enable PWM output as well as
 	 * the regulator. In case of error nothing is changed
 	 */
-	ret = set_pwm(ctx, 70);
+	if (!initial_pwm) {
+		state = &ctx->pwm_state;
+		state->duty_cycle = 0;
+		state->enabled = false;
+		ret = pwm_apply_might_sleep(ctx->pwm, state);
+		if (!ret)
+			ctx->pwm_value = 0;
+	} else {
+		ret = set_pwm(ctx, initial_pwm);
+	}
 	if (ret) {
 		dev_err(dev, "Failed to configure PWM: %d\n", ret);
 		return ret;
 	}
+	pwm_fan_update_state(ctx, initial_pwm);
 	timer_setup(&ctx->rpm_timer, sample_timer, 0);
 	ret = devm_add_action_or_reset(dev, pwm_fan_cleanup, ctx);
 	if (ret)
@@ -682,7 +703,6 @@
 		return PTR_ERR(hwmon);
 	}
 
-	ctx->pwm_fan_state = ctx->pwm_fan_max_state;
 	if (IS_ENABLED(CONFIG_THERMAL)) {
 		cdev = devm_thermal_of_child_cooling_device_register(dev, dev->of_node,
 								     "pwm-fan", ctx,

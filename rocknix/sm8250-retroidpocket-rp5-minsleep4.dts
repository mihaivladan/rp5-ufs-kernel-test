&cpu0_opp13 { /delete-property/ opp-peak-kBps; };
&cpu0_opp14 { /delete-property/ opp-peak-kBps; };
&cpu0_opp15 { /delete-property/ opp-peak-kBps; };
&cpu0_opp16 { /delete-property/ opp-peak-kBps; };
&cpu0_opp17 { /delete-property/ opp-peak-kBps; };
&cpu4_opp1 { /delete-property/ opp-peak-kBps; };
&cpu4_opp2 { /delete-property/ opp-peak-kBps; };
&cpu4_opp3 { /delete-property/ opp-peak-kBps; };
&cpu4_opp4 { /delete-property/ opp-peak-kBps; };
&cpu4_opp5 { /delete-property/ opp-peak-kBps; };
&cpu4_opp6 { /delete-property/ opp-peak-kBps; };
&cpu4_opp7 { /delete-property/ opp-peak-kBps; };
&cpu4_opp8 { /delete-property/ opp-peak-kBps; };
&cpu4_opp9 { /delete-property/ opp-peak-kBps; };
&cpu4_opp10 { /delete-property/ opp-peak-kBps; };
&cpu4_opp11 { /delete-property/ opp-peak-kBps; };
&cpu4_opp12 { /delete-property/ opp-peak-kBps; };
&cpu4_opp13 { /delete-property/ opp-peak-kBps; };
&cpu4_opp14 { /delete-property/ opp-peak-kBps; };

+static void qcom_pcie_diag_fill(struct qcom_pcie *pcie,
+				struct qcom_pcie_diag_snapshot *snapshot,
+				const char *stage, bool mmio_valid)
+{
+	struct dw_pcie *pci = pcie->pci;
+	u16 cap;
+	int i;
+
+	memset(snapshot, 0, sizeof(*snapshot));
+	snapshot->timestamp_ns = ktime_get_mono_fast_ns();
+	strscpy(snapshot->stage, stage, sizeof(snapshot->stage));
+	snapshot->mmio_valid = mmio_valid;
+	snapshot->drv_armed = READ_ONCE(pcie->drv_armed);
+	snapshot->drv_offline = READ_ONCE(pcie->drv_offline);
+	snapshot->resources_suspended = READ_ONCE(pcie->drv_resources_suspended);
+	snapshot->clocks_disabled = READ_ONCE(pcie->drv_clocks_disabled);
+	snapshot->supplies_disabled = READ_ONCE(pcie->drv_supplies_disabled);
+	snapshot->icc_mem_disabled = READ_ONCE(pcie->drv_icc_mem_disabled);
+	snapshot->icc_cpu_disabled = READ_ONCE(pcie->drv_icc_cpu_disabled);
+	snapshot->opp_disabled = READ_ONCE(pcie->drv_opp_disabled);
+
+	if (!mmio_valid)
+		return;
+
+	snapshot->dbi_debug0 = readl_relaxed(pci->dbi_base + QCOM_PCIE_PORT_DEBUG0);
+	snapshot->dbi_debug1 = readl_relaxed(pci->dbi_base + QCOM_PCIE_PORT_DEBUG1);
+	cap = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
+	if (cap)
+		snapshot->dbi_link_control_status =
+			readl_relaxed(pci->dbi_base + cap + PCI_EXP_LNKCTL);
+
+	snapshot->parf_sys_ctrl = readl_relaxed(pcie->parf + PARF_SYS_CTRL);
+	snapshot->parf_pm_ctrl = readl_relaxed(pcie->parf + PARF_PM_CTRL);
+	snapshot->parf_pm_stts = readl_relaxed(pcie->parf + PARF_PM_STTS);
+	snapshot->parf_phy_ctrl = readl_relaxed(pcie->parf + PARF_PHY_CTRL);
+	snapshot->parf_phy_refclk = readl_relaxed(pcie->parf + PARF_PHY_REFCLK);
+	snapshot->parf_mhi_clock_reset_ctrl =
+		readl_relaxed(pcie->parf + PARF_MHI_CLOCK_RESET_CTRL);
+	snapshot->parf_ltssm = readl_relaxed(pcie->parf + PARF_LTSSM);
+	snapshot->parf_clkreq_override =
+		readl_relaxed(pcie->parf + PARF_CLKREQ_OVERRIDE);
+
+	if (pcie->mhi) {
+		snapshot->link_count_l0s = readl_relaxed(pcie->mhi +
+						PARF_DEBUG_CNT_PM_LINKST_IN_L0S);
+		snapshot->link_count_l1 = readl_relaxed(pcie->mhi +
+						PARF_DEBUG_CNT_PM_LINKST_IN_L1);
+		snapshot->link_count_l11 = readl_relaxed(pcie->mhi +
+						PARF_DEBUG_CNT_AUX_CLK_IN_L1SUB_L1);
+		snapshot->link_count_l12 = readl_relaxed(pcie->mhi +
+						PARF_DEBUG_CNT_AUX_CLK_IN_L1SUB_L2);
+		snapshot->link_count_l2 = readl_relaxed(pcie->mhi +
+						PARF_DEBUG_CNT_PM_LINKST_IN_L2);
+	}
+
+	if (!pcie->drv_supported)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(pcie->drv_clks); i++) {
+		struct clk_hw *hw = __clk_get_hw(pcie->drv_clks[i].clk);
+
+		snapshot->clock_rate[i] = clk_get_rate(pcie->drv_clks[i].clk);
+		snapshot->clock_prepared[i] = hw && clk_hw_is_prepared(hw);
+		snapshot->clock_enabled[i] = __clk_is_enabled(pcie->drv_clks[i].clk);
+	}
+}
+
+static void qcom_pcie_diag_snapshot(struct qcom_pcie *pcie, const char *stage,
+				    bool mmio_valid)
+{
+	struct qcom_pcie_diag_snapshot snapshot;
+	unsigned long flags;
+	u32 sequence;
+
+	if (!READ_ONCE(pcie->diag_enabled))
+		return;
+
+	qcom_pcie_diag_fill(pcie, &snapshot, stage, mmio_valid);
+
+	spin_lock_irqsave(&pcie->diag_lock, flags);
+	sequence = pcie->diag_sequence++;
+	snapshot.sequence = sequence;
+	pcie->diag_snapshots[sequence % QCOM_PCIE_DIAG_SNAPSHOT_COUNT] = snapshot;
+	spin_unlock_irqrestore(&pcie->diag_lock, flags);
+}
+
+static void qcom_pcie_diag_print_snapshot(struct seq_file *s,
+					 const struct qcom_pcie_diag_snapshot *snapshot)
+{
+	int i;
+
+	seq_printf(s,
+		   "seq=%u time_ns=%llu stage=%s mmio_valid=%u drv_armed=%u drv_offline=%u resources_suspended=%u clocks_disabled=%u supplies_disabled=%u icc_mem_disabled=%u icc_cpu_disabled=%u opp_disabled=%u\n",
+		   snapshot->sequence, snapshot->timestamp_ns, snapshot->stage,
+		   snapshot->mmio_valid, snapshot->drv_armed, snapshot->drv_offline,
+		   snapshot->resources_suspended, snapshot->clocks_disabled,
+		   snapshot->supplies_disabled, snapshot->icc_mem_disabled,
+		   snapshot->icc_cpu_disabled, snapshot->opp_disabled);
+
+	if (!snapshot->mmio_valid)
+		return;
+
+	seq_printf(s,
+		   " dbi_debug0=%#010x ltssm=%#x dbi_debug1=%#010x link_up=%u training=%u lnkctlsta=%#010x\n",
+		   snapshot->dbi_debug0,
+		   snapshot->dbi_debug0 & (u32)QCOM_PCIE_PORT_DEBUG0_LTSSM_MASK,
+		   snapshot->dbi_debug1,
+		   !!(snapshot->dbi_debug1 & QCOM_PCIE_PORT_DEBUG1_LINK_UP),
+		   !!(snapshot->dbi_debug1 & QCOM_PCIE_PORT_DEBUG1_TRAINING),
+		   snapshot->dbi_link_control_status);
+	seq_printf(s,
+		   " parf_sys_ctrl=%#010x parf_pm_ctrl=%#010x parf_pm_stts=%#010x parf_phy_ctrl=%#010x parf_phy_refclk=%#010x\n",
+		   snapshot->parf_sys_ctrl, snapshot->parf_pm_ctrl,
+		   snapshot->parf_pm_stts, snapshot->parf_phy_ctrl,
+		   snapshot->parf_phy_refclk);
+	seq_printf(s,
+		   " parf_mhi_clock_reset_ctrl=%#010x parf_ltssm=%#010x parf_clkreq_override=%#010x clkreq_enable=%u clkreq_value=%u\n",
+		   snapshot->parf_mhi_clock_reset_ctrl, snapshot->parf_ltssm,
+		   snapshot->parf_clkreq_override,
+		   !!(snapshot->parf_clkreq_override & PARF_CLKREQ_IN_ENABLE),
+		   !!(snapshot->parf_clkreq_override & PARF_CLKREQ_IN_VALUE));
+	seq_printf(s, " counters_l0s=%u l1=%u l1_1=%u l1_2=%u l2=%u\n",
+		   snapshot->link_count_l0s, snapshot->link_count_l1,
+		   snapshot->link_count_l11, snapshot->link_count_l12,
+		   snapshot->link_count_l2);
+
+	for (i = 0; i < QCOM_PCIE_DRV_CLOCK_COUNT; i++)
+		seq_printf(s, " clock_%s_rate=%lu prepared=%u enabled=%u\n",
+			   qcom_pcie_drv_clock_names[i], snapshot->clock_rate[i],
+			   snapshot->clock_prepared[i], snapshot->clock_enabled[i]);
+}
+
+static int qcom_pcie_diag_state_show(struct seq_file *s, void *data)
+{
+	struct qcom_pcie *pcie = dev_get_drvdata(s->private);
+	struct qcom_pcie_diag_snapshot snapshot;
+
+	if (READ_ONCE(pcie->drv_resources_suspended) ||
+	    READ_ONCE(pcie->drv_clocks_disabled) ||
+	    READ_ONCE(pcie->drv_supplies_disabled))
+		return -EBUSY;
+
+	qcom_pcie_diag_fill(pcie, &snapshot, "live", true);
+	qcom_pcie_diag_print_snapshot(s, &snapshot);
+	return 0;
+}
+
+static int qcom_pcie_diag_snapshots_show(struct seq_file *s, void *data)
+{
+	struct qcom_pcie *pcie = dev_get_drvdata(s->private);
+	struct qcom_pcie_diag_snapshot snapshots[QCOM_PCIE_DIAG_SNAPSHOT_COUNT];
+	unsigned long flags;
+	u32 count, first, i;
+
+	spin_lock_irqsave(&pcie->diag_lock, flags);
+	count = min_t(u32, pcie->diag_sequence, QCOM_PCIE_DIAG_SNAPSHOT_COUNT);
+	first = pcie->diag_sequence - count;
+	for (i = 0; i < count; i++)
+		snapshots[i] = pcie->diag_snapshots[(first + i) %
+							 QCOM_PCIE_DIAG_SNAPSHOT_COUNT];
+	spin_unlock_irqrestore(&pcie->diag_lock, flags);
+
+	for (i = 0; i < count; i++)
+		qcom_pcie_diag_print_snapshot(s, &snapshots[i]);
+
+	return 0;
+}

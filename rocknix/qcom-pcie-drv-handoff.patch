+++ b/drivers/pci/controller/dwc/pcie-qcom-drv.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Qualcomm PCIe DRV handoff transport
+ *
+ * The ADSP exposes an RPMSG service named "pcie_drv".  Qualcomm downstream
+ * kernels use it to hand an active PCIe link to the remote power manager
+ * before Linux releases the root-complex clocks, rails and bandwidth votes.
+ */
+
+#include <linux/build_bug.h>
+#include <linux/completion.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/rpmsg.h>
+#include <linux/spinlock.h>
+#include <linux/unaligned.h>
+
+#include "pcie-qcom-drv.h"
+
+#define QCOM_PCIE_DRV_MAJOR_VERSION	1
+#define QCOM_PCIE_DRV_MINOR_VERSION	0
+#define QCOM_PCIE_DRV_RESERVED_SEQ	0xffff
+#define QCOM_PCIE_DRV_TIMEOUT_MS		250
+
+#define QCOM_PCIE_DRV_MSG_ACK		0x000a
+#define QCOM_PCIE_DRV_MSG_CMD		0x000c
+
+#define QCOM_PCIE_DRV_CMD_ENABLE	0xc0000000
+#define QCOM_PCIE_DRV_CMD_DISABLE	0xc0000001
+
+struct qcom_pcie_drv_header {
+	__le16 major_ver;
+	__le16 minor_ver;
+	__le16 msg_id;
+	__le16 seq;
+	__le16 reply_seq;
+	__le16 payload_size;
+	__le32 dev_id;
+	u8 reserved[8];
+} __packed;
+
+struct qcom_pcie_drv_msg {
+	struct qcom_pcie_drv_header header;
+	__le32 dword[4];
+} __packed;
+
+static_assert(sizeof(struct qcom_pcie_drv_header) == 24);
+static_assert(sizeof(struct qcom_pcie_drv_msg) == 40);
+
+struct qcom_pcie_drv_client {
+	struct rpmsg_device *rpdev;
+	struct completion completion;
+	spinlock_t response_lock;
+	u16 sequence;
+	u16 expected_reply_seq;
+	u32 expected_dev_id;
+	int response;
+	bool waiting;
+};
+
+/* The SM8250 firmware exposes one pcie_drv endpoint for all root complexes. */
+static DEFINE_MUTEX(qcom_pcie_drv_lock);
+static struct qcom_pcie_drv_client *qcom_pcie_drv_active;
+
+static int qcom_pcie_drv_xfer(u32 dev_id, u32 command, u32 timeout_ms)
+{
+	struct qcom_pcie_drv_client *client;
+	struct qcom_pcie_drv_msg msg = {};
+	unsigned long flags;
+	unsigned long completed;
+	u16 sequence;
+	int ret;
+
+	mutex_lock(&qcom_pcie_drv_lock);
+	client = qcom_pcie_drv_active;
+	if (!client) {
+		ret = -ENOTCONN;
+		goto out_unlock;
+	}
+
+	sequence = client->sequence++;
+	if (client->sequence == QCOM_PCIE_DRV_RESERVED_SEQ)
+		client->sequence = 0;
+
+	reinit_completion(&client->completion);
+	spin_lock_irqsave(&client->response_lock, flags);
+	client->expected_reply_seq = sequence;
+	client->expected_dev_id = dev_id;
+	client->response = -EINPROGRESS;
+	client->waiting = true;
+	spin_unlock_irqrestore(&client->response_lock, flags);
+
+	msg.header.major_ver = cpu_to_le16(QCOM_PCIE_DRV_MAJOR_VERSION);
+	msg.header.minor_ver = cpu_to_le16(QCOM_PCIE_DRV_MINOR_VERSION);
+	msg.header.msg_id = cpu_to_le16(QCOM_PCIE_DRV_MSG_CMD);
+	msg.header.seq = cpu_to_le16(sequence);
+	msg.header.payload_size = cpu_to_le16(sizeof(msg.dword));
+	msg.header.dev_id = cpu_to_le32(dev_id);
+	msg.dword[0] = cpu_to_le32(command);
+	msg.dword[1] = cpu_to_le32(dev_id);
+	msg.dword[2] = cpu_to_le32(timeout_ms);
+
+	ret = rpmsg_trysend(client->rpdev->ept, &msg, sizeof(msg));
+	if (ret)
+		goto out_cancel;
+
+	completed = wait_for_completion_timeout(&client->completion,
+						msecs_to_jiffies(QCOM_PCIE_DRV_TIMEOUT_MS));
+
+	spin_lock_irqsave(&client->response_lock, flags);
+	if (!completed)
+		ret = -ETIMEDOUT;
+	else
+		ret = client->response;
+	client->waiting = false;
+	spin_unlock_irqrestore(&client->response_lock, flags);
+
+	if (ret)
+		dev_err(&client->rpdev->dev,
+			"command %#x for RC%u failed: %d\n", command, dev_id, ret);
+
+	mutex_unlock(&qcom_pcie_drv_lock);
+	return ret;
+
+out_cancel:
+	spin_lock_irqsave(&client->response_lock, flags);
+	client->waiting = false;
+	spin_unlock_irqrestore(&client->response_lock, flags);
+	dev_err(&client->rpdev->dev,
+		"failed to send command %#x for RC%u: %d\n", command, dev_id, ret);
+out_unlock:
+	mutex_unlock(&qcom_pcie_drv_lock);
+	return ret;
+}
+
+int qcom_pcie_drv_handoff(u32 dev_id, u32 l1ss_timeout_ms)
+{
+	return qcom_pcie_drv_xfer(dev_id, QCOM_PCIE_DRV_CMD_ENABLE,
+				  l1ss_timeout_ms);
+}
+
+int qcom_pcie_drv_reclaim(u32 dev_id)
+{
+	return qcom_pcie_drv_xfer(dev_id, QCOM_PCIE_DRV_CMD_DISABLE, 0);
+}
+
+static void qcom_pcie_drv_complete(struct qcom_pcie_drv_client *client,
+				   u16 reply_seq, u32 dev_id, int response)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&client->response_lock, flags);
+	if (!client->waiting || client->expected_reply_seq != reply_seq ||
+	    client->expected_dev_id != dev_id) {
+		spin_unlock_irqrestore(&client->response_lock, flags);
+		dev_warn(&client->rpdev->dev,
+			 "unexpected ACK for RC%u sequence %u\n", dev_id, reply_seq);
+		return;
+	}
+
+	client->response = response;
+	complete(&client->completion);
+	spin_unlock_irqrestore(&client->response_lock, flags);
+}
+
+static int qcom_pcie_drv_callback(struct rpmsg_device *rpdev, void *data,
+				  int len, void *priv, u32 src)
+{
+	struct qcom_pcie_drv_client *client = dev_get_drvdata(&rpdev->dev);
+	const struct qcom_pcie_drv_header *header = data;
+	u16 payload_size;
+	u16 reply_seq;
+	u32 dev_id;
+	u32 status;
+	int response = 0;
+
+	if (len < sizeof(*header)) {
+		dev_err(&rpdev->dev, "short response: %d bytes\n", len);
+		return -EINVAL;
+	}
+
+	payload_size = le16_to_cpu(header->payload_size);
+	reply_seq = le16_to_cpu(header->reply_seq);
+	dev_id = le32_to_cpu(header->dev_id);
+
+	if (le16_to_cpu(header->msg_id) != QCOM_PCIE_DRV_MSG_ACK)
+		response = -EOPNOTSUPP;
+	else if (payload_size != sizeof(status) ||
+		 len != sizeof(*header) + sizeof(status))
+		response = -EMSGSIZE;
+	else {
+		status = get_unaligned_le32(data + sizeof(*header));
+		if (status) {
+			dev_err(&rpdev->dev, "ACK for RC%u returned status %#x\n",
+				dev_id, status);
+			response = -EREMOTEIO;
+		}
+	}
+
+	qcom_pcie_drv_complete(client, reply_seq, dev_id, response);
+	return response;
+}
+
+static int qcom_pcie_drv_probe(struct rpmsg_device *rpdev)
+{
+	struct qcom_pcie_drv_client *client;
+	int ret = 0;
+
+	client = devm_kzalloc(&rpdev->dev, sizeof(*client), GFP_KERNEL);
+	if (!client)
+		return -ENOMEM;
+
+	client->rpdev = rpdev;
+	init_completion(&client->completion);
+	spin_lock_init(&client->response_lock);
+	dev_set_drvdata(&rpdev->dev, client);
+
+	mutex_lock(&qcom_pcie_drv_lock);
+	if (qcom_pcie_drv_active)
+		ret = -EBUSY;
+	else
+		qcom_pcie_drv_active = client;
+	mutex_unlock(&qcom_pcie_drv_lock);
+
+	if (!ret)
+		dev_info(&rpdev->dev, "Qualcomm PCIe DRV handoff channel connected\n");
+
+	return ret;
+}
+
+static void qcom_pcie_drv_remove(struct rpmsg_device *rpdev)
+{
+	struct qcom_pcie_drv_client *client = dev_get_drvdata(&rpdev->dev);
+
+	/* Serialize against the bounded in-flight transaction. */
+	mutex_lock(&qcom_pcie_drv_lock);
+	if (qcom_pcie_drv_active == client)
+		qcom_pcie_drv_active = NULL;
+	mutex_unlock(&qcom_pcie_drv_lock);
+}
+
+static const struct rpmsg_device_id qcom_pcie_drv_id_table[] = {
+	{ .name = "pcie_drv" },
+	{ }
+};
+MODULE_DEVICE_TABLE(rpmsg, qcom_pcie_drv_id_table);
+
+static struct rpmsg_driver qcom_pcie_drv_driver = {
+	.drv.name = "qcom-pcie-drv",
+	.id_table = qcom_pcie_drv_id_table,
+	.probe = qcom_pcie_drv_probe,
+	.callback = qcom_pcie_drv_callback,
+	.remove = qcom_pcie_drv_remove,
+};
+module_rpmsg_driver(qcom_pcie_drv_driver);
+
+MODULE_DESCRIPTION("Qualcomm PCIe DRV handoff transport");
+MODULE_LICENSE("GPL");

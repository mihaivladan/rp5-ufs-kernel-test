+static int qcom_pcie_drv_restore_resources(struct qcom_pcie *pcie)
+{
+	struct qcom_pcie_resources_2_7_0 *res = &pcie->res.v2_7_0;
+	struct device *dev = pcie->pci->dev;
+	int ret;
+
+	if (pcie->drv_supplies_disabled) {
+		ret = regulator_bulk_enable(ARRAY_SIZE(res->supplies), res->supplies);
+		if (ret)
+			goto err;
+		pcie->drv_supplies_disabled = false;
+	}
+
+	if (pcie->drv_opp_disabled) {
+		ret = qcom_pcie_set_max_opp(dev);
+		if (ret)
+			goto err;
+		pcie->drv_opp_disabled = false;
+	}
+
+	if (pcie->drv_icc_cpu_disabled) {
+		ret = icc_enable(pcie->icc_cpu);
+		if (ret)
+			goto err;
+		pcie->drv_icc_cpu_disabled = false;
+	}
+
+	if (pcie->drv_icc_mem_disabled) {
+		ret = icc_enable(pcie->icc_mem);
+		if (ret)
+			goto err;
+		pcie->drv_icc_mem_disabled = false;
+	}
+
+	if (pcie->drv_clocks_disabled) {
+		ret = clk_bulk_prepare_enable(ARRAY_SIZE(pcie->drv_clks),
+					      pcie->drv_clks);
+		if (ret)
+			goto err;
+		pcie->drv_clocks_disabled = false;
+	}
+
+	pcie->drv_resources_suspended = false;
+	return 0;
+
+err:
+	dev_err(dev, "failed to restore pcie_drv resources: %d\n", ret);
+	return ret;
+}
+
+static int qcom_pcie_drv_suspend_resources(struct qcom_pcie *pcie)
+{
+	struct qcom_pcie_resources_2_7_0 *res = &pcie->res.v2_7_0;
+	struct device *dev = pcie->pci->dev;
+	int ret;
+
+	clk_bulk_disable_unprepare(ARRAY_SIZE(pcie->drv_clks), pcie->drv_clks);
+	pcie->drv_clocks_disabled = true;
+
+	if (pcie->icc_mem) {
+		ret = icc_disable(pcie->icc_mem);
+		if (ret)
+			goto err_restore;
+		pcie->drv_icc_mem_disabled = true;
+	}
+
+	if (pcie->icc_cpu) {
+		ret = icc_disable(pcie->icc_cpu);
+		if (ret)
+			goto err_restore;
+		pcie->drv_icc_cpu_disabled = true;
+	}
+
+	if (pcie->use_pm_opp) {
+		ret = dev_pm_opp_set_opp(dev, NULL);
+		if (ret)
+			goto err_restore;
+		pcie->drv_opp_disabled = true;
+	}
+
+	ret = regulator_bulk_disable(ARRAY_SIZE(res->supplies), res->supplies);
+	if (ret)
+		goto err_restore;
+	pcie->drv_supplies_disabled = true;
+	pcie->drv_resources_suspended = true;
+
+	return 0;
+
+err_restore:
+	dev_err(dev, "failed to release pcie_drv resources: %d\n", ret);
+	qcom_pcie_drv_restore_resources(pcie);
+	return ret;
+}

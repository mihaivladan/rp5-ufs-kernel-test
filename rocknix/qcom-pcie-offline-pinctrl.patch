+
+static ssize_t offline_pins_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct qcom_pcie *pcie = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n",
+			  pcie && pcie->drv_offline_pins_selected ?
+			  "sleep" : "default");
 }
+
+static ssize_t offline_pins_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct qcom_pcie *pcie = dev_get_drvdata(dev);
+	int ret;
 
+	if (!pcie || !pcie->drv_supported)
+		return -EOPNOTSUPP;
+
+	if (sysfs_streq(buf, "sleep")) {
+		if (pcie->drv_armed || pcie->drv_offline ||
+		    dw_pcie_link_up(pcie->pci) ||
+		    qcom_pcie_has_downstream_device(pcie))
+			return -EBUSY;
+
+		ret = pinctrl_pm_select_sleep_state(dev);
+		if (ret)
+			return ret;
+
+		pcie->drv_offline_pins_selected = true;
+		dev_info(dev, "PCIe RC%u offline sleep pins selected while awake\n",
+			 pcie->drv_dev_id);
+	} else if (sysfs_streq(buf, "default")) {
+		if (pcie->drv_armed || pcie->drv_offline ||
+		    pcie->drv_resources_suspended ||
+		    pcie->drv_clocks_disabled || pcie->drv_supplies_disabled ||
+		    pcie->drv_icc_mem_disabled || pcie->drv_icc_cpu_disabled ||
+		    pcie->drv_opp_disabled)
+			return -EBUSY;
+
+		ret = pinctrl_pm_select_default_state(dev);
+		if (ret)
+			return ret;
+
+		pcie->drv_offline_pins_selected = false;
+		dev_info(dev, "PCIe RC%u offline default pins restored while awake\n",
+			 pcie->drv_dev_id);
+	} else {
+		return -EINVAL;
+	}
+
+	return count;
+}
+static DEVICE_ATTR_RW(offline_pins);
+
+static struct attribute *qcom_pcie_attrs[] = {
+	&dev_attr_offline_pins.attr,
+	NULL,
+};

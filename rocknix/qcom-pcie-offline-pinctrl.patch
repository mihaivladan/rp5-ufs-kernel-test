--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -26,6 +26,7 @@
 #include <linux/pci-ecam.h>
 #include <linux/pci-pwrctrl.h>
 #include <linux/pm_opp.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/pm_runtime.h>
 #include <linux/platform_device.h>
 #include <linux/phy/pcie.h>
@@ -1382,6 +1383,18 @@
 	int ret;
 
 	qcom_pcie_perst_assert(pcie);
+	if (pcie->drv_offline) {
+		ret = pinctrl_pm_select_default_state(pci->dev);
+		if (ret) {
+			dev_err(pci->dev,
+				"failed to restore PCIe offline default pins before QCA power-on: %d\n",
+				ret);
+			return ret;
+		}
+		dev_info(pci->dev,
+			 "PCIe RC%u offline default pins restored before QCA power-on\n",
+			 pcie->drv_dev_id);
+	}
 
 	ret = pcie->cfg->ops->init(pcie);
 	if (ret)
@@ -1445,10 +1458,24 @@
 {
 	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
 	struct qcom_pcie *pcie = to_qcom_pcie(pci);
+	int ret;
 
 	qcom_pcie_perst_assert(pcie);
 
-	if (!pci->pp.skip_pwrctrl_off) {
+	if (pcie->drv_offline) {
+		ret = pinctrl_pm_select_sleep_state(pci->dev);
+		if (ret) {
+			dev_err(pci->dev,
+				"failed to select PCIe offline sleep pins after L23: %d\n",
+				ret);
+		} else {
+			dev_info(pci->dev,
+				 "PCIe RC%u offline sleep pins selected after L23\n",
+				 pcie->drv_dev_id);
+		}
+	}
+
+	if (!pci->pp.skip_pwrctrl_off && !pcie->drv_offline) {
 		/*
 		 * No need to destroy pwrctrl devices as this function only
 		 * gets called during system suspend as of now.
@@ -1458,6 +1485,16 @@
 
 	qcom_pcie_phy_power_off(pcie);
 	pcie->cfg->ops->deinit(pcie);
+
+	if (!pci->pp.skip_pwrctrl_off && pcie->drv_offline) {
+		dev_info(pci->dev,
+			 "PCIe RC%u offline PHY/clocks down before QCA power-off\n",
+			 pcie->drv_dev_id);
+		pci_pwrctrl_power_off_devices(pci->dev);
+		dev_info(pci->dev,
+			 "PCIe RC%u offline QCA powered off last\n",
+			 pcie->drv_dev_id);
+	}
 }
 

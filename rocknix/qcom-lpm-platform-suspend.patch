diff --git a/drivers/soc/qcom/qcom_lpm_platform_suspend.c b/drivers/soc/qcom/qcom_lpm_platform_suspend.c
new file mode 100644
index 000000000000..acef9d434662
--- /dev/null
+++ b/drivers/soc/qcom/qcom_lpm_platform_suspend.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Narrow Qualcomm SM8250 platform-suspend experiment.
+ *
+ * Android's downstream lpm-levels driver registers platform suspend ops and
+ * enters the composite CPU/cluster PSCI state selected from kona-pm.dtsi.
+ * Mainline's PSCI cpuidle path exposes only suspend-to-idle on this platform.
+ * This driver supplies only the missing memory-suspend entry semantics.  It
+ * intentionally does not reproduce downstream policy, statistics or debug
+ * machinery.
+ */
+
+#include <linux/atomic.h>
+#include <linux/cpu_pm.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/psci.h>
+#include <linux/suspend.h>
+
+#define CONSOLEOS_SM8250_SUSPEND_STATE	0x4100c244
+
+static u32 consoleos_psci_state;
+static atomic_t consoleos_suspend_sequence = ATOMIC_INIT(0);
+static bool consoleos_suspend_registered;
+
+static int consoleos_suspend_begin(suspend_state_t state)
+{
+	int sequence = atomic_read(&consoleos_suspend_sequence) + 1;
+
+	pr_info("consoleos-lpm: prepare sequence=%d target=%d psci-state=%#x\n",
+		sequence, (__force int)state, consoleos_psci_state);
+
+	return state == PM_SUSPEND_MEM ? 0 : -EINVAL;
+}
+
+static int consoleos_suspend_enter(suspend_state_t state)
+{
+	int sequence = atomic_inc_return(&consoleos_suspend_sequence);
+	int ret;
+
+	if (state != PM_SUSPEND_MEM)
+		return -EINVAL;
+
+	pr_info("consoleos-lpm: enter sequence=%d cpu-pm state=%#x\n",
+		sequence, consoleos_psci_state);
+
+	/*
+	 * The last-CPU CPU_PM_ENTER notification is mainline's equivalent of
+	 * the downstream system_pm prepare callback: rpmh-rsc flushes the
+	 * cached sleep set before firmware receives the composite PSCI state.
+	 */
+	ret = cpu_pm_enter();
+	if (ret) {
+		pr_err("consoleos-lpm: cpu_pm_enter failed sequence=%d ret=%d\n",
+		       sequence, ret);
+		return ret;
+	}
+
+	ret = psci_cpu_suspend_enter(consoleos_psci_state);
+	cpu_pm_exit();
+
+	pr_info("consoleos-lpm: return sequence=%d psci-ret=%d\n",
+		sequence, ret);
+
+	return ret;
+}
+
+static void consoleos_suspend_end(void)
+{
+	pr_info("consoleos-lpm: complete sequence=%d\n",
+		atomic_read(&consoleos_suspend_sequence));
+}
+
+static const struct platform_suspend_ops consoleos_suspend_ops = {
+	.valid = suspend_valid_only_mem,
+	.begin = consoleos_suspend_begin,
+	.enter = consoleos_suspend_enter,
+	.end = consoleos_suspend_end,
+};
+
+static int consoleos_suspend_probe(struct platform_device *pdev)
+{
+	u32 state;
+	int ret;
+
+	ret = of_property_read_u32(pdev->dev.of_node,
+				   "qcom,psci-suspend-state", &state);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "missing qcom,psci-suspend-state\n");
+
+	if (state != CONSOLEOS_SM8250_SUSPEND_STATE)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "refusing unexpected PSCI state %#x\n", state);
+
+	if (!psci_power_state_is_valid(state))
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "invalid PSCI state %#x\n", state);
+
+	if (consoleos_suspend_registered)
+		return dev_err_probe(&pdev->dev, -EBUSY,
+				     "platform suspend operation already registered\n");
+
+	consoleos_psci_state = state;
+	consoleos_suspend_registered = true;
+	suspend_set_ops(&consoleos_suspend_ops);
+
+	dev_info(&pdev->dev,
+		 "registered deep suspend with exact PSCI state %#x\n", state);
+	return 0;
+}
+
+static const struct of_device_id consoleos_suspend_of_match[] = {
+	{ .compatible = "qcom,consoleos-lpm-suspend" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, consoleos_suspend_of_match);
+
+static struct platform_driver consoleos_suspend_driver = {
+	.probe = consoleos_suspend_probe,
+	.driver = {
+		.name = "consoleos-lpm-suspend",
+		.of_match_table = consoleos_suspend_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(consoleos_suspend_driver);
+
+MODULE_DESCRIPTION("ConsoleOS SM8250 exact-state platform suspend experiment");
+MODULE_LICENSE("GPL");

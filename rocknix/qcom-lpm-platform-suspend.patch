+config QCOM_LPM_PLATFORM_SUSPEND
+	bool "Qualcomm SM8250 platform suspend experiment"
+	depends on ARCH_QCOM && ARM64 && ARM_PSCI_FW && CPU_IDLE && SUSPEND
+	help
+	  Register a memory-only platform suspend operation that enters one exact
+	  PSCI power state supplied by Device Tree.  This is a narrowly scoped
+	  diagnostic replacement for the downstream Qualcomm lpm-levels platform
+	  suspend entry; it also invokes the CPU PM notifier chain so RPMh sleep
+	  sets are flushed before firmware entry.
+
+	  This driver is intended only for the ConsoleOS SM8250 deep-sleep
+	  experiment and rejects every PSCI state except 0x4100c244.
+

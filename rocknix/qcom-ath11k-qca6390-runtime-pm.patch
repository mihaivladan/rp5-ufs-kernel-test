+static __maybe_unused int ath11k_pci_runtime_suspend(struct device *dev)
+{
+	struct ath11k_base *ab = dev_get_drvdata(dev);
+	struct ath11k_pci *ab_pci = ath11k_pci_priv(ab);
+	struct pci_dev *pdev = to_pci_dev(dev);
+	int ret;
+
+	if (!ab_pci->runtime_pm_configured)
+		return -EOPNOTSUPP;
+
+	if (ab_pci->runtime_suspended)
+		return 0;
+
+	if (test_bit(ATH11K_FLAG_QMI_FAIL, &ab->dev_flags) ||
+	    test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags))
+		return -EBUSY;
+
+	ret = mhi_pm_suspend(ab_pci->mhi_ctrl);
+	if (ret) {
+		ath11k_dbg(ab, ATH11K_DBG_PCI,
+			   "runtime MHI suspend deferred: %d wake=%d pending=%d\n",
+			   ret, atomic_read(&ab_pci->mhi_ctrl->dev_wake),
+			   atomic_read(&ab_pci->mhi_ctrl->pending_pkts));
+		return -EBUSY;
+	}
+
+	/*
+	 * QCA6390 with PCIe DRV ownership does not use the generic MHI PCI
+	 * D3hot sequence.  The target enters M3 while the endpoint remains in
+	 * D0, then the root complex/DRV side is allowed to idle the link.  In
+	 * particular, MHI resume rings event doorbells before normal traffic
+	 * restarts; putting the endpoint in D3hot makes those writes Unsupported
+	 * Requests on this device.
+	 *
+	 * Mark the PCI state saved so the PCI runtime-PM wrapper does not call
+	 * pci_finish_runtime_suspend() and force the endpoint into D3hot after
+	 * this callback returns.
+	 */
+	pci_save_state(pdev);
+	ab_pci->runtime_suspended = true;
+	ab_pci->runtime_suspend_count++;
+	ath11k_info(ab,
+		    "QCA6390 runtime suspend complete: count=%u MHI=%u endpoint=D0\n",
+		    ab_pci->runtime_suspend_count, ab_pci->mhi_ctrl->dev_state);
+
+	return 0;
+}
+
+static __maybe_unused int ath11k_pci_runtime_resume(struct device *dev)
+{
+	struct ath11k_base *ab = dev_get_drvdata(dev);
+	struct ath11k_pci *ab_pci = ath11k_pci_priv(ab);
+	struct pci_dev *pdev = to_pci_dev(dev);
+	int ret;
+
+	if (!ab_pci->runtime_suspended)
+		return 0;
+
+	/* The PCI core restored the saved D0 configuration before this hook. */
+	pci_set_master(pdev);
+
+	ret = mhi_pm_resume(ab_pci->mhi_ctrl);
+	if (ret) {
+		ath11k_warn(ab, "QCA6390 runtime MHI resume failed: %d\n", ret);
+		return ret;
+	}
+
+	ab_pci->runtime_suspended = false;
+	pm_runtime_mark_last_busy(dev);
+	ath11k_info(ab,
+		    "QCA6390 runtime resume complete: count=%u MHI=%u endpoint=D0\n",
+		    ab_pci->runtime_suspend_count, ab_pci->mhi_ctrl->dev_state);
+
+	return 0;
+}

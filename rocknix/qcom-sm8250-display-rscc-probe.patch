 #define MIN_IB_BW	400000000UL /* Min ib vote 400MB */
 
+/*
+ * Read-only ConsoleOS diagnostic for the display RSC that downstream Android
+ * owns but upstream Linux does not model on SM8250.  The offsets below are
+ * the exact register set used by Qualcomm's downstream sde_rsc_debug_show().
+ */
+#define SM8250_RSCC_DRV_PHYS		0x0af20000
+#define SM8250_RSCC_DRV_SIZE		0x00003c50
+#define SM8250_RSCC_WRAPPER_PHYS	0x0af30000
+#define SM8250_RSCC_WRAPPER_SIZE	0x00003fd4
+
+#define RSCC_ERROR_IRQ_STATUS		0x0d0
+#define RSCC_SEQ_BUSY			0x404
+#define RSCC_SEQ_PROGRAM_COUNTER	0x408
+#define RSCC_SOLVER_OVERRIDE_CTRL	0xc14
+#define RSCC_SOLVER_MODES_ENABLED	0xc20
+#define RSCC_SOLVER_STATUS0		0xc24
+#define RSCC_SOLVER_STATUS1		0xc28
+#define RSCC_SOLVER_STATUS2		0xc2c
+#define RSCC_AMC_TCS_MODE_IRQ_STATUS	0x1c00
+
+#define RSCC_WRAPPER_CTRL		0x000
+#define RSCC_WRAPPER_OVERRIDE_CTRL	0x004
+#define RSCC_WRAPPER_POWER_CTRL		0x024
+
 struct msm_mdss_data {
 	u32 reg_bus_bw;
 };
@@ -42,6 +67,11 @@ struct msm_mdss {
 	struct icc_path *mdp_path[2];
 	u32 num_mdp_paths;
 	struct icc_path *reg_bus_path;
+
+	struct clk *rscc_ahb_clk;

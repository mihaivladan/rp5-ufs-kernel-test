--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -2404,7 +2404,12 @@
 			return -EIO;
 		}
 
-		return qcom_pcie_drv_suspend_resources(pcie);
+		if (!pcie->drv_offline)
+			return qcom_pcie_drv_suspend_resources(pcie);
+
+		dev_info(dev, "PCIe RC%u offline using D3cold host teardown\n",
+			 pcie->drv_dev_id);
+		/* Endpoint absent: use the existing DesignWare/Qualcomm teardown. */
 	}
 
 	ret = dw_pcie_suspend_noirq(pcie->pci);
@@ -2412,6 +2417,13 @@
 	if (ret)
 		return ret;
 
+	if (pcie->drv_offline) {
+		if (!pcie->pci->suspended)
+			return dev_err_probe(dev, -EIO,
+					     "offline D3cold host teardown did not suspend RC\n");
+		dev_info(dev, "PCIe RC%u offline D3cold host teardown completed\n",
+			 pcie->drv_dev_id);
+	}
 	if (pcie->pci->suspended) {
 		ret = icc_disable(pcie->icc_mem);
 		if (ret)
@@ -2464,7 +2476,7 @@
 	pcie = dev_get_drvdata(dev);
 	if (!pcie)
 		return 0;
-	if (pcie->drv_armed || pcie->drv_offline) {
+	if (pcie->drv_armed) {
 		if (!pcie->drv_resources_suspended &&
 		    !pcie->drv_clocks_disabled && !pcie->drv_supplies_disabled &&
 		    !pcie->drv_icc_mem_disabled && !pcie->drv_icc_cpu_disabled &&
@@ -2521,6 +2533,13 @@
 
 	qcom_pcie_icc_opp_update(pcie);
 
+	if (pcie->drv_offline) {
+		if (pcie->pci->suspended)
+			return dev_err_probe(dev, -EIO,
+					     "offline D3cold host restore left RC suspended\n");
+		dev_info(dev, "PCIe RC%u offline D3cold host restored\n",
+			 pcie->drv_dev_id);
+	}
 	return 0;
 disable_icc_mem:
 	icc_disable(pcie->icc_mem);
@@ -2539,7 +2558,8 @@
 	if (pcie->drv_offline) {
 		if (pcie->drv_resources_suspended || pcie->drv_clocks_disabled ||
 		    pcie->drv_supplies_disabled || pcie->drv_icc_mem_disabled ||
-		    pcie->drv_icc_cpu_disabled || pcie->drv_opp_disabled) {
+		    pcie->drv_icc_cpu_disabled || pcie->drv_opp_disabled ||
+		    pcie->pci->suspended) {
 			dev_err(dev, "refusing offline completion before resources are restored\n");
 			return -EIO;
 		}

+bool qcom_pcie_orderly_restore_pending(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *bridge;
+	struct qcom_pcie *pcie;
+
+	if (!pdev)
+		return false;
+
+	bridge = pci_find_host_bridge(pdev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return false;
+
+	pcie = dev_get_drvdata(bridge->dev.parent);
+	return pcie && pcie->orderly_endpoint == pdev &&
+	       pcie->orderly_restore_pending;
+}
+EXPORT_SYMBOL_GPL(qcom_pcie_orderly_restore_pending);
+
+int qcom_pcie_orderly_restore_root(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *bridge;
+	struct qcom_pcie *pcie;
+	struct device *dev;
+	int ret;
+
+	if (!pdev)
+		return -ENODEV;
+
+	bridge = pci_find_host_bridge(pdev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return -ENODEV;
+
+	dev = bridge->dev.parent;
+	pcie = dev_get_drvdata(dev);
+	if (!pcie || pcie->orderly_endpoint != pdev ||
+	    !pcie->orderly_poweroff || !pcie->orderly_restore_pending)
+		return -EALREADY;
+	if (!pcie->pci->suspended)
+		return 0;
+
+	ret = pinctrl_pm_select_default_state(dev);
+	if (ret)
+		return ret;
+
+	ret = icc_enable(pcie->icc_cpu);
+	if (ret)
+		return ret;
+
+	ret = icc_enable(pcie->icc_mem);
+	if (ret) {
+		icc_disable(pcie->icc_cpu);
+		return ret;
+	}
+
+	ret = dw_pcie_resume_noirq(pcie->pci);
+	if (ret) {
+		icc_disable(pcie->icc_mem);
+		icc_disable(pcie->icc_cpu);
+		return ret;
+	}
+
+	dev_info(dev,
+		 "orderly QCA restore: ICC, root complex and endpoint rails restored asynchronously\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_pcie_orderly_restore_root);
+
+void qcom_pcie_orderly_restore_complete(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *bridge;
+	struct qcom_pcie *pcie;
+
+	if (!pdev)
+		return;
+
+	bridge = pci_find_host_bridge(pdev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return;
+
+	pcie = dev_get_drvdata(bridge->dev.parent);
+	if (!pcie || pcie->orderly_endpoint != pdev ||
+	    !pcie->orderly_restore_pending || pcie->pci->suspended)
+		return;
+
+	qcom_pcie_orderly_poweroff_clear(pcie);
+	qcom_pcie_icc_opp_update(pcie);
+	dev_info(pcie->pci->dev, "orderly QCA restore: completed\n");
+}
+EXPORT_SYMBOL_GPL(qcom_pcie_orderly_restore_complete);

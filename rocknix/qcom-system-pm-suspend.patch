--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -124,6 +124,20 @@ config QCOM_RMTFS_MEM
 
 	  Say y here if you intend to boot the modem remoteproc.
 
+config QCOM_SYSTEM_PM_SUSPEND
+	bool "Qualcomm SM8250 system-PM suspend experiment"
+	depends on ARCH_QCOM && ARM64 && ARM_PSCI_FW && CPU_IDLE && SUSPEND
+	depends on QCOM_RPMH=y
+	help
+	  Register a memory-only platform suspend operation for the ConsoleOS
+	  SM8250 experiment. Before entering the one accepted PSCI state, the
+	  driver performs the downstream system-PM admission and preparation
+	  operations directly against the referenced Apps RPMh RSC: active-TCS
+	  idle check, sleep/wake cache flush, and CONTROL_TCS wake programming.
+
+	  This is diagnostic-only. It rejects every PSCI state except
+	  0x4100c244 and records every admission and preparation result.
+
 config QCOM_RPM_MASTER_STATS
 	tristate "Qualcomm RPM Master stats"
 	depends on ARCH_QCOM || COMPILE_TEST

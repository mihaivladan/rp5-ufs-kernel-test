+static int qcom_fg_gen4_init(struct qcom_fg_chip *chip)
+{
+	u8 subtype, rev4;
+	int ret;
+
+	ret = regmap_bulk_read(chip->regmap, PMIC_REVID_SUBTYPE, &subtype, 1);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(chip->regmap, PMIC_REVID_REVISION4, &rev4, 1);
+	if (ret)
+		return ret;
+
+	chip->pmic_rev4 = rev4;
+	if (subtype != PM8150B_SUBTYPE)
+		return -ENODEV;
+
+	switch (rev4) {
+	case PM8150B_V1_REV4:
+		chip->gen4_layout = &pm8150b_v1_layout;
+		break;
+	case PM8150B_V2_REV4:
+		chip->gen4_layout = &pm8150b_v2_layout;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	ret = qcom_fg_masked_write(chip, MEM_IF_DMA_CTL(chip),
+			GEN4_DMA_ADDR_KIND, GEN4_DMA_ADDR_KIND);
+	if (ret)
+		return ret;
+
+	qcom_fg_gen4_release_access(chip);
+	dev_info(chip->dev, "enabled read-only Gen4 diagnostics for %s\n",
+			chip->gen4_layout->name);
+	return 0;
+}

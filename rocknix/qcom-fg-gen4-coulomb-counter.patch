+static int qcom_fg_gen4_dma_address(u16 word, u8 offset, u16 *addr)
+{
+	static const struct {
+		u16 first;
+		u16 last;
+		u16 base;
+	} partitions[] = {
+		{ 0, 63, 0x4420 },
+		{ 64, 169, 0x4520 },
+		{ 170, 274, 0x4620 },
+		{ 275, 299, 0x4720 },
+		{ 300, 405, 0x4820 },
+		{ 406, 486, 0x4920 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(partitions); i++) {
+		if (word < partitions[i].first || word > partitions[i].last)
+			continue;
+
+		*addr = partitions[i].base + (word - partitions[i].first) * 2 +
+			offset;
+		return 0;
+	}
+
+	return -ERANGE;
+}
+
+static int qcom_fg_gen4_poll_alg_idle(struct qcom_fg_chip *chip)
+{
+	u8 value = GEN4_ALG_ACTIVE_PEEK_CFG;
+	int i, ret;
+
+	ret = qcom_fg_write(chip, &value, GEN4_BATT_INFO_PEEK_MUX4, 1);
+	if (ret)
+		return ret;
+
++	for (i = 0; i < 35; i++) {
+		ret = qcom_fg_read(chip, &value, GEN4_BATT_INFO_PEEK_RD, 1);
+		if (ret)
+			return ret;
+		if (!(value & GEN4_ALG_ACTIVE)) {
+			usleep_range(1000, 1100);
+			return 0;
+		}
++		usleep_range(10000, 10100);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static void qcom_fg_gen4_release_access(struct qcom_fg_chip *chip)
+{
+	int ret;
+
+	ret = qcom_fg_masked_write(chip, MEM_INTF_CFG(chip),
+			GEN4_MEM_ACCESS_REQ | GEN4_IACS_SLCT, 0);
+	if (ret)
+		dev_warn(chip->dev, "failed to release Gen4 memory access: %d\n", ret);
+
+	ret = qcom_fg_masked_write(chip, MEM_INTF_ARB_CFG(chip),
+			GEN4_MEM_ARB_REQ, 0);
+	if (ret)
+		dev_warn(chip->dev, "failed to release Gen4 memory arbiter: %d\n", ret);
+}
+
+static int qcom_fg_gen4_request_access(struct qcom_fg_chip *chip)
+{
+	u8 status;
+	int i, ret;
+
+	if (chip->pmic_rev4 == PM8150B_V1_REV4) {
+		ret = qcom_fg_gen4_poll_alg_idle(chip);
+		if (ret)
+			return ret;
+	}
+
+	ret = qcom_fg_masked_write(chip, MEM_INTF_ARB_CFG(chip),
+			GEN4_MEM_ARB_REQ, GEN4_MEM_ARB_REQ);
+	if (ret)
+		return ret;
+
+	ret = qcom_fg_masked_write(chip, MEM_INTF_CFG(chip),
+			GEN4_MEM_ACCESS_REQ | GEN4_IACS_SLCT,
+			GEN4_MEM_ACCESS_REQ);
+	if (ret)
+		goto release;
+
+	usleep_range(40, 50);
+	for (i = 0; i < GEN4_MEM_GNT_RETRIES; i++) {
+		ret = qcom_fg_read(chip, &status, MEM_INTF_STS(chip), 1);
+		if (ret)
+			goto release;
+		if (status & GEN4_MEM_GNT) {
+			if (chip->pmic_rev4 == PM8150B_V1_REV4)
+				usleep_range(1000, 1100);
+			return 0;
+		}
+		usleep_range(GEN4_MEM_GNT_WAIT_US,
+				GEN4_MEM_GNT_WAIT_US + 100);
+	}
+
+	ret = -ETIMEDOUT;
+release:
+	qcom_fg_gen4_release_access(chip);
+	return ret;
+}
+
+static int qcom_fg_gen4_dma_read(struct qcom_fg_chip *chip, u16 word,
+		u8 offset, void *data, size_t len)
+{
+	u16 addr;
+	int ret;
+
+	ret = qcom_fg_gen4_dma_address(word, offset, &addr);
+	if (ret)
+		return ret;
+
+	return regmap_bulk_read(chip->regmap, addr, data, len);
+}
+
+static int qcom_fg_gen4_read_diag(struct qcom_fg_chip *chip,
+		struct qcom_fg_gen4_diag *diag)
+{
+	const struct qcom_fg_gen4_layout *layout = chip->gen4_layout;
+	u8 raw[4];
+	int ret;
+
+	if (!layout)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&chip->gen4_dma_lock);
+	ret = qcom_fg_gen4_request_access(chip);
+	if (ret)
+		goto unlock;
+
+	ret = qcom_fg_gen4_dma_read(chip, GEN4_NOM_CAP_WORD, 0, raw, 2);
+	if (ret)
+		goto release;
+	diag->nominal_cap_mah = get_unaligned_le16(raw);
+
+	ret = qcom_fg_gen4_dma_read(chip, layout->act_batt_cap_word, 0,
+			raw, 2);
+	if (ret)
+		goto release;
+	diag->learned_cap_mah = get_unaligned_le16(raw);
+
+	ret = qcom_fg_gen4_dma_read(chip, layout->batt_soc_word, 0, raw, 4);
+	if (ret)
+		goto release;
+	diag->batt_soc = get_unaligned_le32(raw);
+
+	ret = qcom_fg_gen4_dma_read(chip, layout->cc_soc_sw_word, 0,
+			raw, 4);
+	if (ret)
+		goto release;
+	diag->cc_soc_sw = (s32)get_unaligned_le32(raw);
+
+	ret = qcom_fg_gen4_dma_read(chip, layout->cc_soc_word, 0, raw, 4);
+	if (ret)
+		goto release;
+	diag->cc_soc = (s32)get_unaligned_le32(raw);
+
+	ret = qcom_fg_read(chip, diag->monotonic_soc,
+			BATT_MONOTONIC_SOC, sizeof(diag->monotonic_soc));
+	if (ret)
+		goto release;
+
+	diag->charge_counter_uah = div_s64((s64)diag->cc_soc_sw *
+			diag->learned_cap_mah * 1000, GEN4_CC_SOC_MAX);
+	diag->charge_raw_uah = div_s64((s64)diag->cc_soc *
+			diag->nominal_cap_mah * 1000, GEN4_CC_SOC_MAX);
+	diag->charge_shadow_uah = div64_u64((u64)diag->batt_soc *
+			diag->learned_cap_mah * 1000, U32_MAX);
+release:
+	qcom_fg_gen4_release_access(chip);
+unlock:
+	mutex_unlock(&chip->gen4_dma_lock);
+	return ret;
+}
+
+static int qcom_fg_gen4_get_charge_counter(struct qcom_fg_chip *chip,
+		int *value)
+{
+	struct qcom_fg_gen4_diag diag = {};
+	int ret;
+
+	ret = qcom_fg_gen4_read_diag(chip, &diag);
+	if (!ret)
+		*value = diag.charge_counter_uah;
+
+	return ret;
+}
+
+static ssize_t gen4_diagnostics_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct qcom_fg_chip *chip = dev_get_drvdata(dev);
+	struct qcom_fg_gen4_diag diag = {};
+	int ret;
+
+	ret = qcom_fg_gen4_read_diag(chip, &diag);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf,
+		"format_version=1\n"
+		"pmic_rev4=%u\n"
+		"layout=%s\n"
+		"monotonic_soc_raw_0=%u\n"
+		"monotonic_soc_raw_1=%u\n"
+		"nominal_capacity_raw_mah=%u\n"
+		"learned_capacity_raw_mah=%u\n"
+		"batt_soc_raw=%u\n"
+		"cc_soc_sw_raw=%d\n"
+		"cc_soc_raw=%d\n"
+		"charge_counter_uah=%lld\n"
+		"charge_raw_uah=%lld\n"
+		"charge_shadow_uah=%llu\n",
+		chip->pmic_rev4, chip->gen4_layout->name,
+		diag.monotonic_soc[0], diag.monotonic_soc[1],
+		diag.nominal_cap_mah, diag.learned_cap_mah,
+		diag.batt_soc, diag.cc_soc_sw, diag.cc_soc,
++		(long long)diag.charge_counter_uah,
++		(long long)diag.charge_raw_uah,
++		(unsigned long long)diag.charge_shadow_uah);
+}
+static DEVICE_ATTR_RO(gen4_diagnostics);

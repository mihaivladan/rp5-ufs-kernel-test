+
+static ssize_t orderly_awake_poweroff_store(struct device *dev,
+					    struct device_attribute *attr,
+					    const char *buf, size_t count)
+{
+	struct ath11k_base *ab = dev_get_drvdata(dev);
+	struct ath11k_pci *ab_pci = ath11k_pci_priv(ab);
+	int ret;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (pm_suspend_target_state != PM_SUSPEND_ON)
+		return -EBUSY;
 
+	mutex_lock(&ab_pci->orderly_awake_lock);
+	if (ab_pci->orderly_awake_down) {
+		ret = -EALREADY;
+		goto out_unlock;
+	}
+	if (!ath11k_hif_orderly_poweroff_enabled(ab)) {
+		ret = -EPERM;
+		goto out_unlock;
+	}
+
+	ret = qcom_pcie_orderly_poweroff_prepare(ab_pci->pdev);
+	if (ret) {
+		ath11k_warn(ab,
+			    "orderly QCA awake-off: PCIe runtime resume/reclaim failed: %d\n",
+			    ret);
+		goto out_unlock;
+	}
+	ath11k_info(ab,
+		    "orderly QCA awake-off: PCIe/MHI responsive in process context\n");
+
+	ret = ath11k_core_suspend(ab);
+	if (ret) {
+		ath11k_warn(ab,
+			    "orderly QCA awake-off: core quiesce failed: %d\n", ret);
+		goto out_unlock;
+	}
+
+	mhi_pm_set_channel_suspend_state(ab_pci->mhi_ctrl,
+					 MHI_CHANNEL_SUSPEND_RETAINED);
+	ret = ath11k_core_suspend_late(ab);
+	if (ret) {
+		ath11k_warn(ab,
+			    "orderly QCA awake-off: endpoint shutdown failed: %d\n",
+			    ret);
+		goto out_unlock;
+	}
+
+	ret = qcom_pcie_orderly_poweroff_awake(ab_pci->pdev);
+	if (ret) {
+		ath11k_warn(ab,
+			    "orderly QCA awake-off: root shutdown failed: %d\n", ret);
+		goto out_unlock;
+	}
+
+	ab_pci->orderly_early_down = true;
+	ab_pci->orderly_awake_down = true;
+	atomic_set(&ab_pci->orderly_awake_wake_attempts, 0);
+	ath11k_info(ab,
+		    "orderly QCA awake-off: complete before system suspend; wait_ms=%u\n",
+		    orderly_awake_wait_ms);
+	ret = count;
+
+out_unlock:
+	mutex_unlock(&ab_pci->orderly_awake_lock);
+	return ret;
+}

+int qcom_pcie_orderly_poweroff_awake(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *bridge;
+	struct qcom_pcie *pcie;
+	struct device *dev;
+	int ret;
+
+	if (!pdev)
+		return -ENODEV;
+
+	bridge = pci_find_host_bridge(pdev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return -ENODEV;
+
+	dev = bridge->dev.parent;
+	pcie = dev_get_drvdata(dev);
+	if (!pcie || !pcie->orderly_poweroff ||
+	    pcie->orderly_endpoint != pdev)
+		return -EPERM;
+	if (pcie->orderly_awake_offline || pcie->pci->suspended)
+		return -EALREADY;
+	if (!dw_pcie_link_up(pcie->pci))
+		return -ENOLINK;
 
+	pci_save_state(pdev);
+	ret = pci_set_power_state(pdev, PCI_D3hot);
+	if (ret) {
+		dev_err(dev,
+			"orderly QCA awake-off: endpoint D3hot failed: %d\n",
+			ret);
+		return ret;
+	}
+	if (pdev->current_state != PCI_D3hot)
+		return -EIO;
+
+	dev_info(dev,
+		 "orderly QCA awake-off: endpoint D3hot; forcing L23 and host shutdown\n");
+	ret = dw_pcie_suspend_noirq_force(pcie->pci);
+	if (ret)
+		goto err_endpoint_d0;
+	if (!pcie->pci->suspended) {
+		ret = -EIO;
+		goto err_endpoint_d0;
+	}
+
+	ret = icc_disable(pcie->icc_mem);
+	if (ret)
+		goto err_host_resume;
+	ret = icc_disable(pcie->icc_cpu);
+	if (ret)
+		goto err_icc_mem;
+
+	if (orderly_awake_gdsc_off) {
+		ret = pm_runtime_put_sync_suspend(dev);
+		if (ret < 0) {
+			pm_runtime_get_noresume(dev);
+			goto err_icc_cpu;
+		}
+		pcie->orderly_awake_gdsc_suspended = true;
+	}
+
+	pcie->orderly_awake_offline = true;
+	dev_info(dev,
+		 "orderly QCA awake-off: root, PHY, clocks, package rails and ICC off; genpd=%s\n",
+		 pcie->orderly_awake_gdsc_suspended ? "off" : "retained");
+	return 0;
+
+err_icc_cpu:
+	icc_enable(pcie->icc_cpu);
+err_icc_mem:
+	icc_enable(pcie->icc_mem);
+err_host_resume:
+	pinctrl_pm_select_default_state(dev);
+	dw_pcie_resume_noirq(pcie->pci);
+err_endpoint_d0:
+	pci_set_power_state(pdev, PCI_D0);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_pcie_orderly_poweroff_awake);
+
+int qcom_pcie_orderly_poweroff_resume(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *bridge;
+	struct qcom_pcie *pcie;
+	struct device *dev;
+	int ret;
+
+	if (!pdev)
+		return -ENODEV;
+	bridge = pci_find_host_bridge(pdev->bus);
+	if (!bridge || !bridge->dev.parent)
+		return -ENODEV;
+
+	dev = bridge->dev.parent;
+	pcie = dev_get_drvdata(dev);
+	if (!pcie || !pcie->orderly_poweroff ||
+	    pcie->orderly_endpoint != pdev)
+		return -EPERM;
+	if (!pcie->pci->suspended)
+		return 0;
+
+	if (pcie->orderly_awake_gdsc_suspended) {
+		ret = pm_runtime_get_sync(dev);
+		if (ret < 0) {
+			pm_runtime_put_noidle(dev);
+			dev_err(dev,
+				"orderly QCA awake-off: failed to restore PCIe genpd: %d\n",
+				ret);
+			return ret;
+		}
+		pcie->orderly_awake_gdsc_suspended = false;
+	}
+
+	ret = pinctrl_pm_select_default_state(dev);
+	if (ret)
+		return ret;
+	ret = icc_enable(pcie->icc_cpu);
+	if (ret)
+		return ret;
+	ret = icc_enable(pcie->icc_mem);
+	if (ret)
+		goto err_disable_icc_cpu;
+	ret = dw_pcie_resume_noirq(pcie->pci);
+	if (ret)
+		goto err_disable_icc_mem;
+
+	dev_info(dev,
+		 "orderly QCA awake-off: genpd, ICC, root and endpoint rails restored\n");
+	return 0;
+
+err_disable_icc_mem:
+	icc_disable(pcie->icc_mem);
+err_disable_icc_cpu:
+	icc_disable(pcie->icc_cpu);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_pcie_orderly_poweroff_resume);

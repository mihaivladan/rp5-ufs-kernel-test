+static void qcom_mhi_qrtr_resume_work(struct work_struct *work)
+{
+	struct qrtr_mhi_dev *qdev =
+		container_of(work, struct qrtr_mhi_dev, resume_work);
+	struct mhi_controller *mhi_cntrl = qdev->mhi_dev->mhi_cntrl;
+	int rc;
+
+	if (!atomic_xchg(&qdev->resume_deferred, 0))
+		return;
+
+	rc = mhi_prepare_for_transfer(qdev->mhi_dev);
+	if (!rc)
+		rc = qcom_mhi_qrtr_queue_dl_buffers(qdev->mhi_dev);
+	if (rc) {
+		dev_err(qdev->dev,
+			"deferred autoqueue restore failed: %d\n", rc);
+		return;
+	}
+
+	mhi_pm_set_channel_suspend_state(mhi_cntrl,
+					 MHI_CHANNEL_SUSPEND_DEFAULT);
+	dev_info(qdev->dev, "deferred autoqueue restore completed\n");
+}
+
+static void qcom_mhi_qrtr_status_cb(struct mhi_device *mhi_dev,
+				    enum mhi_callback callback)
+{
+	struct qrtr_mhi_dev *qdev = dev_get_drvdata(&mhi_dev->dev);
+
+	if (qdev && callback == MHI_CB_EE_MISSION_MODE &&
+	    atomic_read(&qdev->resume_deferred))
+		schedule_work(&qdev->resume_work);
+}
+

+bool command_get_load_state_status(command_t *cmd, const char *arg)
+{
+   uint64_t generation = 0;
+   char reply[96];
+   const char *name;
+   enum content_load_state_status status =
+      content_get_load_state_status(&generation);
+   size_t len;
+
+   (void)arg;
+   switch (status)
+   {
+      case CONTENT_LOAD_STATE_PENDING:
+         name = "PENDING";
+         break;
+      case CONTENT_LOAD_STATE_SUCCEEDED:
+         name = "SUCCEEDED";
+         break;
+      case CONTENT_LOAD_STATE_FAILED:
+         name = "FAILED";
+         break;
+      case CONTENT_LOAD_STATE_IDLE:
+      default:
+         name = "IDLE";
+         break;
+   }
+   len = snprintf(reply, sizeof(reply), "LOAD_STATE_STATUS %" PRIu64 " %s\n",
+         generation, name);
+   cmd->replier(cmd, reply, len);
+   return true;
+}

+static ssize_t orderly_idle_cycle_ms_store(struct device *dev,
+					   struct device_attribute *attr,
+					   const char *buf, size_t count)
+{
+	struct qcom_pcie *pcie = dev_get_drvdata(dev);
+	unsigned int idle_ms;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &idle_ms);
+	if (ret)
+		return ret;
+	if (idle_ms < 1000 || idle_ms > 60000)
+		return -ERANGE;
+	if (!pcie || !pcie->drv_supported || pcie->drv_dev_id != 0)
+		return -EOPNOTSUPP;
+	if (pm_suspend_target_state != PM_SUSPEND_ON)
+		return -EBUSY;
+	if (!mutex_trylock(&pcie->orderly_idle_cycle_lock))
+		return -EBUSY;
+
+	if (pcie->drv_armed || pcie->drv_offline || pcie->orderly_poweroff ||
+	    pcie->drv_resources_suspended || pcie->pci->suspended) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	if (!dw_pcie_link_up(pcie->pci)) {
+		ret = -ENOLINK;
+		goto out_unlock;
+	}
+
+	ret = qcom_pcie_drv_handoff(pcie->drv_dev_id,
+				    pcie->drv_l1ss_timeout_ms);
+	if (ret)
+		goto out_unlock;
+	pcie->drv_armed = true;
+	dev_info(dev,
+		 "orderly idle cycle: PCIe RC%u handed to ADSP for %u ms\n",
+		 pcie->drv_dev_id, idle_ms);
+
+	ret = qcom_pcie_drv_suspend_resources(pcie);
+	if (ret)
+		goto out_reclaim;
+
+	msleep(idle_ms);
+
+	ret = qcom_pcie_drv_restore_resources(pcie);
+	if (ret)
+		goto out_unlock;
+
+out_reclaim:
+	if (!pcie->drv_resources_suspended && !pcie->drv_clocks_disabled &&
+	    !pcie->drv_supplies_disabled && !pcie->drv_icc_mem_disabled &&
+	    !pcie->drv_icc_cpu_disabled && !pcie->drv_opp_disabled) {
+		int reclaim_ret;
+
+		reclaim_ret = qcom_pcie_drv_reclaim(pcie->drv_dev_id);
+		if (!reclaim_ret) {
+			pcie->drv_armed = false;
+			qcom_pcie_icc_opp_update(pcie);
+			dev_info(dev,
+				 "orderly idle cycle: PCIe RC%u reclaimed after %u ms\n",
+				 pcie->drv_dev_id, idle_ms);
+		} else if (!ret) {
+			ret = reclaim_ret;
+		}
+	}
+
+out_unlock:
+	mutex_unlock(&pcie->orderly_idle_cycle_lock);
+	return ret ? ret : count;
+}

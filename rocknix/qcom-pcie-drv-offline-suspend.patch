+static int qcom_pcie_find_downstream_device(struct pci_dev *pdev, void *data)
+{
+	bool *present = data;
+
+	if (!pci_is_root_bus(pdev->bus)) {
+		*present = true;
+		return 1;
+	}
+
+	return 0;
 }
 
+static bool qcom_pcie_has_downstream_device(struct qcom_pcie *pcie)
+{
+	struct pci_host_bridge *bridge = pcie->pci->pp.bridge;
+	bool present = false;
+
+	if (!bridge || !bridge->bus)
+		return true;
+
+	pci_walk_bus(bridge->bus, qcom_pcie_find_downstream_device, &present);
+	return present;
+}

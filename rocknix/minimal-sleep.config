CONFIG_LOCALVERSION="-consoleos-minsleep1"
# CONFIG_LOCALVERSION_AUTO is not set

# Evidence and recovery interfaces retained.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Required suspend and CPU power path.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_ARM_PSCI_FW=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8250=y

# Required PMIC, Power button and SD boot/storage path.
CONFIG_SPMI=y
CONFIG_REGMAP_SPMI=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_PINCTRL_SM8250=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_SQUASHFS=y

# Deliberately absent hardware. The proof recorder will run locally from SD;
# this image has no SSH/network-device requirement.
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_PCI is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_RPMSG is not set
# CONFIG_SERIAL_QCOM_GENI is not set
# CONFIG_I2C_QCOM_GENI is not set
# CONFIG_SPI_QCOM_GENI is not set
# CONFIG_QCOM_GENI_SE is not set
# CONFIG_CRYPTO_DEV_QCE is not set
# CONFIG_QCOM_ICC_BWMON is not set
# CONFIG_SM_CAMCC_8250 is not set
# CONFIG_SM_DISPCC_8250 is not set
# CONFIG_SM_GPUCC_8250 is not set
# CONFIG_SM_VIDEOCC_8250 is not set
# CONFIG_CLK_GFM_LPASS_SM8250 is not set
# CONFIG_PINCTRL_SM8250_LPASS_LPI is not set
# CONFIG_SENSORS_PWM_FAN is not set
# CONFIG_INPUT_QCOM_SPMI_HAPTICS is not set

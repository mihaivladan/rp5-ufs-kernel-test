+static int qcom_pcie_orderly_force_gdsc_collapse(struct qcom_pcie *pcie)
+{
+	void __iomem *gdscr;
+	u32 before, after;
+	int ret;
+
+	/* SM8250 describes PCIe0 as RET_ON, so genpd's power_off callback
+	 * intentionally leaves this register physically on. Qualcomm's
+	 * downstream driver collapses the domain for radio-off. This guarded
+	 * diagnostic write is made only after the endpoint, root, PHY, clocks
+	 * and ICC paths are already off.
+	 */
+	gdscr = ioremap(PCIE0_GDSCR_PHYS, sizeof(u32));
+	if (!gdscr)
+		return -ENOMEM;
+
+	before = readl_relaxed(gdscr);
+	writel_relaxed(before | GDSCR_SW_COLLAPSE, gdscr);
+	ret = readl_poll_timeout(gdscr, after, !(after & GDSCR_PWR_ON),
+				 1, 2000);
+	dev_info(pcie->pci->dev,
+		 "orderly QCA awake-off: PCIe0 GDSCR collapse before=%#x after=%#x ret=%d\n",
+		 before, after, ret);
+	iounmap(gdscr);
+
+	return ret;
+}
+
+static int qcom_pcie_orderly_restore_gdsc_on(struct qcom_pcie *pcie)
+{
+	void __iomem *gdscr;
+	u32 before, after;
+	int ret;
+
+	gdscr = ioremap(PCIE0_GDSCR_PHYS, sizeof(u32));
+	if (!gdscr)
+		return -ENOMEM;
+
+	before = readl_relaxed(gdscr);
+	writel_relaxed(before & ~GDSCR_SW_COLLAPSE, gdscr);
+	udelay(1);
+	ret = readl_poll_timeout(gdscr, after, after & GDSCR_PWR_ON,
+				 1, 2000);
+	dev_info(pcie->pci->dev,
+		 "orderly QCA awake-off: PCIe0 GDSCR restore before=%#x after=%#x ret=%d\n",
+		 before, after, ret);
+	iounmap(gdscr);
 
+	return ret;
+}
